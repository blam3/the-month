{
  "name": "@blam3/plugin-budgeted-choice",
  "version": "0.1.1",
  "description": "A jsPsych plugin for budgeted choices under risk and ambiguity, with a runnable browser demonstration and local data export.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "unpkg": "dist/index.global.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/version.mjs && rollup --config",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "dev": "node scripts/serve.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "build:demo": "npm run build && node scripts/prepare-demo.mjs",
    "build:pages": "npm run build:demo && node scripts/prepare-pages.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blam3/the-month.git"
  },
  "author": "Brendan Lam",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "jspsych": ">=8.2.1 <9"
  },
  "devDependencies": {
    "@jspsych/plugin-html-button-response": "2.1.0",
    "@jspsych/plugin-instructions": "2.1.0",
    "@jspsych/test-utils": "1.2.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^29.5.14",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jsdom": "^20.0.3",
    "jspsych": "8.2.1",
    "playwright": "^1.56.1",
    "rollup": "^4.44.0",
    "ts-jest": "^29.4.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
